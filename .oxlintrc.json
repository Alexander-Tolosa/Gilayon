{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "typescript",
    "oxc"
  ],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "app/**"
      ],
      "rules": {
        "react/only-export-components": "off"
      }
    },
    {
      "files": [
        "src/features/clinic/ClinicShell.tsx",
        "src/features/clinic/pages/DailyReport.tsx",
        "src/features/clinic/pages/QueueBoard.tsx",
        "src/features/clinic/store/store.tsx",
        "src/features/portal/store/store.tsx",
        "src/shared/components/ui.tsx"
      ],
      "rules": {
        "react/only-export-components": "off"
      }
    },
    {
      "files": [
        "src/features/clinic/components/CameraCapture.tsx"
      ],
      "rules": {
        "react/set-state-in-effect": "off"
      }
    }
  ]
}
