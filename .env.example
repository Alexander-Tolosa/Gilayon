# PostgreSQL on the clinic server PC. Leave empty to use the embedded database in ./.data (demo and development).
DATABASE_URL=

# Settings named GILAYON_* also work under their old names (HIMSOG_AUTO_SEED and so on).

# Set to 0 to stop an empty embedded database from being filled with the synthetic demo clinic.
GILAYON_AUTO_SEED=1

# Allow "Reset demo data" in Settings outside the development demo. Keep off on a real clinic server.
GILAYON_ALLOW_RESET=0

# Minutes without a touch, key or scroll before a screen signs itself out (0 = never).
# Unsent offline notes stay on the computer. The server enforces the same time.
IDLE_MINUTES=15

# Demo helpers (filled-in demo password, "Try the demo" searches, "synthetic demo data" on prints,
# Reset demo data). Empty = automatic: on for the embedded demo database, off once DATABASE_URL is set
# or GILAYON_AUTO_SEED=0. Set 1 or 0 to force it.
NEXT_PUBLIC_DEMO=

# Where scanned pages are stored on the server PC (include this folder in the nightly backup).
UPLOADS_DIR=./uploads

# ---- Backups ----------------------------------------------------------------
# Folder for backups. Point it at the USB drive, for example E:\GilayonBackups. If the drive is
# missing the backup fails loudly instead of quietly writing to the C: drive.
BACKUP_DIR=./backups
# Optional second copy kept off the clinic PC (a synced cloud folder or a network share).
BACKUP_OFFSITE_DIR=
# REQUIRED. Backups hold patient records and are encrypted with this. At least 12 characters.
# Keep a copy somewhere safe and separate: without it a backup cannot be opened.
BACKUP_PASSPHRASE=
# How many backups to keep in each folder (minimum 3).
BACKUP_KEEP=14
# Local time of the nightly backup. If the PC was off then, it runs at the next start.
BACKUP_AT=02:00
# Set to 0 to turn off the nightly schedule (you can still back up by hand).
BACKUP_ENABLED=1
# Only for development: allow unencrypted backups.
BACKUP_ALLOW_UNENCRYPTED=0

# ---- HTTPS (npm run start:https) ---------------------------------------------
# Folder with the clinic CA and server certificate made by `npm run https:setup`.
TLS_DIR=./certs
HTTPS_PORT=3443
# Plain HTTP only redirects to HTTPS and serves /ca.crt for setting up a new PC.
HTTP_PORT=3000
# Names a PC may use to reach this server (comma separated). Used by https:setup.
GILAYON_HOSTNAMES=

# ---- Scan old folder: optional local models via Ollama ---------------------------
# Both models run on this PC; nothing leaves the clinic. Without them the OCR and rules still work.
OLLAMA_URL=http://127.0.0.1:11434
# Small text model that tidies what the OCR read (ollama pull llama3.2:3b, about 2 GB).
OLLAMA_MODEL=llama3.2:3b
# Handwriting reader: a vision model that looks at the picture itself (ollama pull qwen2.5vl:3b, about 3.2 GB,
# about 5 GB of memory while it works). Used only when someone presses "Read handwriting" on the scan screen.
OLLAMA_VISION_MODEL=qwen2.5vl:3b
# Longest a handwriting read may take, in milliseconds (the first one after start-up also loads the model).
OLLAMA_VISION_TIMEOUT_MS=240000
# Pictures are shrunk to this long edge, in pixels, before the vision model sees them.
OLLAMA_VISION_EDGE=1800
# Set to 1 to turn off both models.
OLLAMA_DISABLED=0
