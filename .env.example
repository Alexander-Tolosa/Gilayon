# PostgreSQL on the clinic server PC. Leave empty to use the embedded database in ./.data (demo and development).
DATABASE_URL=

# Set to 0 to stop an empty embedded database from being filled with the synthetic demo clinic.
HIMSOG_AUTO_SEED=1

# Allow "Reset demo data" in Settings on a production build. Keep off on a real clinic server.
HIMSOG_ALLOW_RESET=0

# Pre-fill the demo password on the sign-in page. Turn off (0) on a real clinic server.
NEXT_PUBLIC_DEMO=1

# Where scanned pages are stored on the server PC (include this folder in the nightly backup).
UPLOADS_DIR=./uploads
